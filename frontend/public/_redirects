/assets/* /assets/:splat 200
/icons/* /icons/:splat 200
/manifest.json /manifest.json 200
/sw.js /sw.js 200
/robots.txt /robots.txt 200
/sitemap.xml /sitemap.xml 200

# NOTE: Do NOT add explicit /faq → /faq.html rewrites here.
# Cloudflare Pages automatically serves faq.html at /faq (pretty URLs).
# Adding a rewrite rule creates a redirect loop because Cloudflare Pages
# also redirects /faq.html → /faq as a canonical redirect.

# SPA fallback — serves root (index.html) for any route not matched by a static file.
# Must use /* / 200 (root proxy), NOT /* /index.html 200 — Cloudflare Pages rejects
# the latter because its pretty-URL engine would strip .html and re-trigger the rule.
/* / 200
